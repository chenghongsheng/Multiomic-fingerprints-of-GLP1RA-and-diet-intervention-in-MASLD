## actual WGCNA analysis ####
# Check sample clustering to detect outliers
sample_tree <- hclust(dist(t(all.dat)), method = "average")
plot(sample_tree, main = "Sample Clustering to Detect Outliers", xlab = "", sub = "")

# Test different powers to achieve scale-free topology
powers <- c(1:20)
sft <- pickSoftThreshold(t(all.dat), powerVector = powers, verbose = 5)

# Plot the results
par(mfrow = c(1, 2))
plot(sft$fitIndices[,1], -sign(sft$fitIndices[,3]) * sft$fitIndices[,2],
     xlab = "Soft Threshold (Power)", ylab = "Scale Free Topology Model Fit (R²)",
     main = "Scale Independence")
abline(h = 0.90, col = "red")  # Aim for R² > 0.9

plot(sft$fitIndices[,1], sft$fitIndices[,5],
     xlab = "Soft Threshold (Power)", ylab = "Mean Connectivity",
     main = "Mean Connectivity")

# Set the selected power
power <- 8  # Adjust based on the plot above

# Build the adjacency matrix
adjacency <- adjacency(t(all.dat), power = power)

# Convert to Topological Overlap Matrix (TOM) to minimize noise
TOM <- TOMsimilarity(adjacency)
dissTOM <- 1 - TOM  # Dissimilarity measure

# Cluster genes/modules
geneTree <- hclust(as.dist(dissTOM), method = "average")

# Plot the clustering tree
plot(geneTree, xlab = "", sub = "", main = "Gene Clustering on TOM-based Dissimilarity")


# Dynamic tree cutting to define modules
dynamicMods <- cutreeDynamic(dendro = geneTree, distM = dissTOM,
                             deepSplit = 2, pamRespectsDendro = FALSE,
                             minClusterSize = 100)  # Adjust minClusterSize as needed

# Assign module colors
moduleColors <- labels2colors(dynamicMods)

# Plot the module assignment
plotDendroAndColors(geneTree, moduleColors, "Dynamic Tree Cut",
                    dendroLabels = FALSE, hang = 0.03,
                    addGuide = TRUE, guideHang = 0.05)

