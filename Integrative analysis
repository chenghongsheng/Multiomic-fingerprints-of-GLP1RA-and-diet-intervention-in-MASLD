## pairwise correlation  #####


##find correlated genes
flattenCorrMatrix <- function(cormat, pmat) {
  ut <- upper.tri(cormat)
  data.frame(
    row = rownames(cormat)[row(cormat)[ut]],
    column = rownames(cormat)[col(cormat)[ut]],
    cor  =(cormat)[ut],
    p = pmat[ut]
  )
}

# sema 
sema.feature <- output.df %>%
  subset(!is.na(pattern.sema)) %>%
  rownames(.)
sema.group<-metadata %>%
  subset(Treatment %in% c('LP','LPS')) %>%
  rownames(.)

corr.sema <-all.dat[sema.feature,sema.group]
corr.sema<- rcorr(as.matrix(t(corr.sema)),type=c("spearman"))
corr.sema.df<-as.data.frame(flattenCorrMatrix(corr.sema$r,corr.sema$P))
corr.sema.df$FDR<-p.adjust(corr.sema.df$p,method='fdr')

corr.sema.df <- corr.sema.df %>%
  subset(abs(cor)>0.95 & FDR<0.05)
corr.sema.df$logp<--log10(corr.sema.df$FDR+0.000231269)

write.csv(corr.sema.df,'corr.sema.df.csv')




